# Пример окружения. Скопируйте в .env и подставьте свои значения.
# Файл .env в .gitignore — ключи в репозиторий не попадают.

# Провайдер генерации по умолчанию: ollama | gigachat | kie
PROVIDER=ollama

# --- 🟢 Ollama: локально, ключ не нужен ---
# Нужен запущенный Ollama с моделями bge-m3 и qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=qwen2.5:7b

# --- 🔴 GigaChat: РФ-контур ---
# Ключ авторизации из личного кабинета developers.sber.ru (строка Base64)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Перед первым запуском: python setup_certs.py — поставит сертификаты НУЦ Минцифры.
# Аварийный путь урока (проверка сертификата отключается, сервер не подтверждён):
# GIGACHAT_INSECURE=1

# --- 🟢 Kie: шлюз к GPT-5.x (замена прямому OpenAI, недоступному из РФ) ---
KIE_API_KEY=
KIE_MODEL=gpt-5-6-sol
KIE_EFFORT=low

# --- Параметры RAG ---
TOP_K=3
TEMPERATURE=0.1
MAX_TOKENS=1000

# --- Оценка качества (evaluate_ragas.py): судья метрик ---
# Судья намеренно не тот, кто отвечает: независимая модель оценивает чужую работу
ANTHROPIC_API_KEY=
